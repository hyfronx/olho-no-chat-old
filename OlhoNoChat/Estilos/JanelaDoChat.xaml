<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:OlhoNoChat.Controles">

    <!-- O visual da janela do chat: a barra laranja, os painéis de tamanho do texto e fundo, as faixas escuras (canal e
         caixa de escrever) e a lista de emotes. Em cima dos estilos comuns das janelas (Controles.xaml). -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ctl:VisivelSe x:Key="VisivelSe" />

    <!-- Os ícones das faixas escuras e da lista de emotes: os do Windows 10, mais finos que os da barra laranja -->
    <Style x:Key="IconeDaFaixa" TargetType="TextBlock" BasedOn="{StaticResource Icone}">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    </Style>

    <!-- As faixas escuras dentro da moldura (faixa do canal e caixa de escrever) -->
    <SolidColorBrush x:Key="FundoDaFaixa" Color="#F2141414" />
    <SolidColorBrush x:Key="LinhaDaFaixa" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ErroDaFaixa" Color="#FFB9A0" />

    <!-- A nota do TikTok (num quadrado de 24): o logo na faixa do canal e no botão do Chat Multiplataforma -->
    <StreamGeometry x:Key="NotaDoTikTok">M 12.525 .02 c 1.31 -.02 2.61 -.01 3.91 -.02 .08 1.53 .63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79 v 4.03 c -1.44 -.05 -2.89 -.35 -4.2 -.97 -.57 -.26 -1.1 -.59 -1.62 -.93 -.01 2.92 .01 5.84 -.02 8.75 -.08 1.4 -.54 2.79 -1.35 3.94 -1.31 1.92 -3.58 3.17 -5.91 3.21 -1.43 .08 -2.86 -.31 -4.08 -1.03 -2.02 -1.19 -3.44 -3.37 -3.65 -5.71 -.02 -.5 -.03 -1 -.01 -1.49 .18 -1.9 1.12 -3.72 2.58 -4.96 1.66 -1.44 3.98 -2.13 6.15 -1.72 .02 1.48 -.04 2.96 -.04 4.44 -.99 -.32 -2.15 -.23 -3.02 .37 -.63 .41 -1.11 1.04 -1.36 1.75 -.21 .51 -.15 1.07 -.14 1.61 .24 1.64 1.82 3.02 3.5 2.87 1.12 -.01 2.19 -.66 2.77 -1.61 .19 -.33 .4 -.67 .41 -1.06 .1 -1.79 .06 -3.57 .07 -5.36 .01 -4.03 -.01 -8.05 .02 -12.07 z</StreamGeometry>

    <!-- Botões da barra laranja com um painel embaixo: escurecidos enquanto o painel está aberto (Tag = "aberto") -->
    <Style x:Key="BotaoDaBarraComPainel" TargetType="Button" BasedOn="{StaticResource BotaoDaBarra}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource BotaoDaBarraComMouse}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource BotaoDaBarraApertado}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="aberto">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource BotaoDaBarraApertado}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botões de ligar/desligar da barra ("Sempre no topo", "Multiplataforma", "Escrever"): ligados, ganham uma barrinha
         branca embaixo, como uma aba ativa (o ícone também muda: alfinete fincado, logos coloridos). Sem fundo branco
         (pedido do usuário em 2026-10-23). -->
    <Style x:Key="BotaoDaBarraLigaDesliga" TargetType="ToggleButton" BasedOn="{StaticResource BotaoDaBarra}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Marca" Width="14" Height="3" CornerRadius="1.5" Background="White" Margin="0,0,0,-2"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource BotaoDaBarraComMouse}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource BotaoDaBarraApertado}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Traço entre os grupos de botões da barra -->
    <Style x:Key="SeparadorDaBarra" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Fill" Value="#66FFFFFF" />
    </Style>

    <!-- "Fundo": um quadrado com três barras, da cheia à fraca (a opacidade diminuindo; as fontes de ícones não têm um igual) -->
    <ControlTemplate x:Key="IconeDoFundo" TargetType="ContentControl">
        <!-- Desenhado em 16 e mostrado em 20: o quadrado fica da altura dos ícones de fonte da barra (a engrenagem, o olho) -->
        <Viewbox Width="20" Height="20">
            <Canvas Width="16" Height="16">
                <Rectangle Canvas.Left="0.6" Canvas.Top="0.6" Width="14.8" Height="14.8" RadiusX="3" RadiusY="3"
                           Stroke="{TemplateBinding Foreground}" StrokeThickness="1.15" />
                <Rectangle Canvas.Left="2.7" Canvas.Top="2.9" Width="3" Height="10.2" RadiusX="0.8" RadiusY="0.8" Fill="{TemplateBinding Foreground}" />
                <Rectangle Canvas.Left="6.5" Canvas.Top="2.9" Width="3" Height="10.2" RadiusX="0.8" RadiusY="0.8" Fill="{TemplateBinding Foreground}" Opacity="0.6" />
                <Rectangle Canvas.Left="10.3" Canvas.Top="2.9" Width="3" Height="10.2" RadiusX="0.8" RadiusY="0.8" Fill="{TemplateBinding Foreground}" Opacity="0.25" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Alfinete com "Sempre no topo" ligado; alfinete riscado desligado -->
    <Style x:Key="IconeSempreNoTopo" TargetType="TextBlock" BasedOn="{StaticResource Icone}">
        <Setter Property="Text" Value="&#xE77A;" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <Setter Property="Text" Value="&#xE840;" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Painéis de tamanho do texto e fundo ===== -->

    <Style x:Key="TrilhaDoDeslizanteDoPainel" TargetType="RepeatButton" BasedOn="{StaticResource TrilhaDoDeslizante}" />

    <Style x:Key="PuxadorDoDeslizanteDoPainel" TargetType="Thumb">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Ellipse Fill="#454545" Stroke="#33FFFFFF" StrokeThickness="1" />
                        <Ellipse x:Name="Miolo" Width="12" Height="12" Fill="{StaticResource LaranjaClaro}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Miolo" Property="Width" Value="14" />
                            <Setter TargetName="Miolo" Property="Height" Value="14" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Miolo" Property="Width" Value="10" />
                            <Setter TargetName="Miolo" Property="Height" Value="10" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Trilho fino, laranja até a bolinha e cinza depois; clicar no trilho leva a bolinha para lá -->
    <Style TargetType="ctl:ControleDeslizante">
        <Setter Property="Height" Value="26" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:ControleDeslizante">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource TrilhaDoDeslizanteDoPainel}" Background="{StaticResource LaranjaClaro}"
                                          Command="Slider.DecreaseLarge" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource TrilhaDoDeslizanteDoPainel}" Background="#4DFFFFFF"
                                          Command="Slider.IncreaseLarge" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource PuxadorDoDeslizanteDoPainel}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- O painel embaixo de um botão da barra (um Popup é uma janela à parte: aparece por cima da página do chat) -->
    <Style x:Key="PainelRapido" TargetType="Border">
        <Setter Property="Width" Value="240" />
        <Setter Property="Padding" Value="14,10,14,8" />
        <Setter Property="Background" Value="{StaticResource FundoDaPagina}" />
        <Setter Property="BorderBrush" Value="#4DFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Texto}" />
        <Setter Property="TextElement.FontSize" Value="13" />
    </Style>

    <Style x:Key="LegendaDoPainel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextoDaDica}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Faixas escuras ===== -->

    <!-- Botão sem fundo: a faixa fechada inteira, um ícone ou um link dentro das faixas -->
    <Style x:Key="BotaoPlano" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="#0DFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Voltar ao padrão" dos painéis -->
    <Style x:Key="BotaoVoltarAoPadrao" TargetType="Button" BasedOn="{StaticResource BotaoPlano}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="6,0,-4,0" />
        <Setter Property="Foreground" Value="{StaticResource TextoDaDica}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Um emote da lista: o clique põe o nome na caixa de mensagem (o foco fica lá) -->
    <Style x:Key="BotaoDoEmote" TargetType="Button" BasedOn="{StaticResource BotaoPlano}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- "Baixar e instalar" do WebView2: o azul da Microsoft -->
    <Style x:Key="BotaoAzul" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#0078D4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="#1A86D9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="#006CBE" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fundo" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
