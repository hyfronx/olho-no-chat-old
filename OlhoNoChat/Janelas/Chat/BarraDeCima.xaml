<UserControl x:Class="OlhoNoChat.Janelas.Chat.BarraDeCima"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chat="clr-namespace:OlhoNoChat.Janelas.Chat">
    <UserControl.Resources>
        <Style x:Key="IconeDaBarra" TargetType="TextBlock" BasedOn="{StaticResource Icone}">
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Resources>

    <!-- A barra laranja (só com as bordas visíveis): arrastar move a janela; os botões só têm ícone, o nome fica na dica -->
    <Grid x:Name="barra" Height="32" Background="{StaticResource Laranja}" MouseLeftButtonDown="Barra_MouseLeftButtonDown">
        <Button x:Name="botaoFecharJanela" Style="{StaticResource BotaoFecharDaBarra}" HorizontalAlignment="Right" Margin="0,0,3,0"
                ToolTip="Fechar o Olho no Chat" AutomationProperties.Name="Fechar" Click="Fechar_Click" />
        <StackPanel Orientation="Horizontal" Margin="3,0,40,0" VerticalAlignment="Center">
            <!-- Olho riscado -->
            <Button x:Name="botaoOcultarBordas" Style="{StaticResource BotaoDaBarra}" AutomationProperties.Name="Ocultar bordas"
                    Click="OcultarBordas_Click">
                <TextBlock Style="{StaticResource IconeDaBarra}" Text="&#xED1A;" />
            </Button>

            <Rectangle Style="{StaticResource SeparadorDaBarra}" />

            <!-- Abrem um painel com o controle deslizante; a rodinha em cima deles muda o valor na hora -->
            <Button x:Name="botaoTamanhoDoTexto" Style="{StaticResource BotaoDaBarraComPainel}" AutomationProperties.Name="Tamanho do texto"
                    PreviewMouseLeftButtonDown="BotaoDePainel_PreviewMouseLeftButtonDown" Click="BotaoDePainel_Click"
                    PreviewMouseWheel="BotaoDePainel_PreviewMouseWheel" MouseLeave="BotaoDePainel_MouseLeave">
                <Button.ToolTip>
                    <ToolTip x:Name="dicaTamanhoDoTexto" />
                </Button.ToolTip>
                <TextBlock Style="{StaticResource IconeDaBarra}" Text="&#xE8D2;" />
            </Button>
            <Button x:Name="botaoFundo" Style="{StaticResource BotaoDaBarraComPainel}" AutomationProperties.Name="Fundo"
                    PreviewMouseLeftButtonDown="BotaoDePainel_PreviewMouseLeftButtonDown" Click="BotaoDePainel_Click"
                    PreviewMouseWheel="BotaoDePainel_PreviewMouseWheel" MouseLeave="BotaoDePainel_MouseLeave">
                <Button.ToolTip>
                    <ToolTip x:Name="dicaFundo" />
                </Button.ToolTip>
                <ContentControl Template="{StaticResource IconeDoFundo}" />
            </Button>

            <Rectangle Style="{StaticResource SeparadorDaBarra}" />

            <!-- Aceso com o alfinete enquanto está ligado -->
            <ToggleButton x:Name="botaoSempreNoTopo" Style="{StaticResource BotaoDaBarraLigaDesliga}" AutomationProperties.Name="Sempre no topo"
                          Checked="SempreNoTopo_Mudou" Unchecked="SempreNoTopo_Mudou">
                <TextBlock Style="{StaticResource IconeSempreNoTopo}" FontSize="20" />
            </ToggleButton>
            <Rectangle Style="{StaticResource SeparadorDaBarra}" />

            <!-- Chat Multiplataforma (Twitch, YouTube, Kick e TikTok) ou só a Twitch: os logos das quatro plataformas em
                 bolinhas sobrepostas do tamanho da engrenagem (opção "C", escolhida pelo usuário em 2026-10-23; por ela a
                 janela tem largura mínima de 376). Ligado: todos coloridos; só Twitch: o do
                 YouTube, o da Kick e o do TikTok ficam apagados, em branco e laranja. O anel da cor da barra separa as
                 bolinhas. -->
            <ToggleButton x:Name="botaoMultiplataforma" Style="{StaticResource BotaoDaBarraLigaDesliga}" Width="76"
                          AutomationProperties.Name="Chat Multiplataforma" Checked="Multiplataforma_Mudou" Unchecked="Multiplataforma_Mudou">
                <ToggleButton.Resources>
                    <!-- Apagado em só Twitch -->
                    <Style x:Key="LogoQueAcende" TargetType="Grid">
                        <Setter Property="Opacity" Value="0.45" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <!-- O fundo do logo: branco em só Twitch, a cor da plataforma (Tag) ligado -->
                    <Style x:Key="FundoDoLogo" TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <!-- As sombras azul e vermelha da nota do TikTok: só ligado -->
                    <Style x:Key="SombraDoLogo" TargetType="Path">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <!-- O desenho do logo: laranja em só Twitch, a cor dele (Tag) ligado -->
                    <Style x:Key="DesenhoDoLogo" TargetType="Path">
                        <Setter Property="Fill" Value="{StaticResource Laranja}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                <Setter Property="Fill" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Resources>
                <StackPanel Orientation="Horizontal">
                    <Border Width="23" Height="23" CornerRadius="11.5" Background="{StaticResource Laranja}" Panel.ZIndex="4">
                        <Grid Width="20" Height="20">
                            <Border CornerRadius="10" Background="#9146FF" />
                            <Viewbox Width="9.5" Height="11" Margin="0,1,0,0">
                                <Canvas Width="2400" Height="2800">
                                    <Path Fill="White" Data="M500,0 L0,500 V2300 H600 V2800 L1100,2300 H1500 L2400,1400 V0 Z" />
                                    <Path Fill="#9146FF" Data="M1700,550 H1900 V1150 H1700 Z M1150,550 H1350 V1150 H1150 Z" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>
                    <Border Width="23" Height="23" CornerRadius="11.5" Background="{StaticResource Laranja}" Panel.ZIndex="3" Margin="-7,0,0,0">
                        <Grid Width="20" Height="20" Style="{StaticResource LogoQueAcende}">
                            <Border CornerRadius="10" Tag="#FF0000" Style="{StaticResource FundoDoLogo}" />
                            <Path Data="M8,6 V14 L14.6,10 Z" Tag="White" Style="{StaticResource DesenhoDoLogo}" />
                        </Grid>
                    </Border>
                    <Border Width="23" Height="23" CornerRadius="11.5" Background="{StaticResource Laranja}" Panel.ZIndex="2" Margin="-7,0,0,0">
                        <Grid Width="20" Height="20" Style="{StaticResource LogoQueAcende}">
                            <Border CornerRadius="10" Tag="#0B0B0B" Style="{StaticResource FundoDoLogo}" />
                            <Viewbox Width="10" Height="10">
                                <Canvas Width="9" Height="9">
                                    <Path Canvas.Left="-2.5" Canvas.Top="-2.5" Tag="#53FC18" Style="{StaticResource DesenhoDoLogo}"
                                          Data="M2.5,2.5 H5.5 V5.1 H6.8 V3.8 H8.1 V2.5 H11.5 V5.5 H10.2 V6.7 H8.9 V7.3 H10.2 V8.5 H11.5 V11.5 H8.1 V10.2 H6.8 V8.9 H5.5 V11.5 H2.5 Z" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>
                    <Border Width="23" Height="23" CornerRadius="11.5" Background="{StaticResource Laranja}" Panel.ZIndex="1" Margin="-7,0,0,0">
                        <Grid Width="20" Height="20" Style="{StaticResource LogoQueAcende}">
                            <Border CornerRadius="10" Tag="Black" Style="{StaticResource FundoDoLogo}" />
                            <Viewbox Width="11.5" Height="11.5">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource NotaDoTikTok}" Fill="#25F4EE" Canvas.Left="-1.3" Canvas.Top="-1.3" Style="{StaticResource SombraDoLogo}" />
                                    <Path Data="{StaticResource NotaDoTikTok}" Fill="#FE2C55" Canvas.Left="1.3" Canvas.Top="1.3" Style="{StaticResource SombraDoLogo}" />
                                    <Path Data="{StaticResource NotaDoTikTok}" Tag="White" Style="{StaticResource DesenhoDoLogo}" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>
                </StackPanel>
            </ToggleButton>

            <!-- Abre e fecha a caixa "Escrever no chat…": aceso enquanto ela está aberta -->
            <ToggleButton x:Name="botaoEscrever" Style="{StaticResource BotaoDaBarraLigaDesliga}" AutomationProperties.Name="Escrever"
                          Checked="Escrever_Mudou" Unchecked="Escrever_Mudou">
                <TextBlock Style="{StaticResource IconeDaBarra}" Text="&#xE8BD;" />
            </ToggleButton>
            <Rectangle Style="{StaticResource SeparadorDaBarra}" />

            <!-- Abre as Configurações (botão esquerdo ou direito) -->
            <Button x:Name="botaoConfiguracoes" Style="{StaticResource BotaoDaBarra}" ToolTip="Configurações"
                    AutomationProperties.Name="Configurações" Click="Configuracoes_Click" MouseRightButtonUp="Configuracoes_Click">
                <TextBlock Style="{StaticResource IconeDaBarra}" Text="&#xE713;" />
            </Button>
        </StackPanel>

        <Popup x:Name="painelTamanhoDoTexto" PlacementTarget="{Binding ElementName=botaoTamanhoDoTexto}" Placement="Bottom"
               VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <chat:PainelDeAjuste x:Name="ajusteTamanhoDoTexto" Nome="TamanhoDoTexto" Titulo="Tamanho do texto"
                                 Minimo="0.5" Maximo="2.5" Passo="0.05" PassoDoTeclado="0.1" PassoDaRodinha="0.1"
                                 LegendaMenor="menor" LegendaMaior="maior">
                <chat:PainelDeAjuste.Icone>
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE8D2;" FontSize="15" />
                </chat:PainelDeAjuste.Icone>
            </chat:PainelDeAjuste>
        </Popup>

        <Popup x:Name="painelFundo" PlacementTarget="{Binding ElementName=botaoFundo}" Placement="Bottom"
               VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <!-- Em porcentagem; gravado de 0 a 255 -->
            <chat:PainelDeAjuste x:Name="ajusteFundo" Nome="Fundo" Titulo="Fundo do chat"
                                 Minimo="0" Maximo="100" Passo="5" PassoDoTeclado="5" PassoDaRodinha="5"
                                 LegendaMenor="transparente" LegendaMaior="escuro">
                <chat:PainelDeAjuste.Icone>
                    <ContentControl Template="{StaticResource IconeDoFundo}" />
                </chat:PainelDeAjuste.Icone>
            </chat:PainelDeAjuste>
        </Popup>
    </Grid>
</UserControl>
