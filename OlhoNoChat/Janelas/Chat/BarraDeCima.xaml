<UserControl x:Class="OlhoNoChat.Janelas.Chat.BarraDeCima"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chat="clr-namespace:OlhoNoChat.Janelas.Chat">
    <UserControl.Resources>
        <Style x:Key="IconeDaBarra" TargetType="TextBlock" BasedOn="{StaticResource Icone}">
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Resources>

    <!-- A barra laranja (só com as bordas visíveis): arrastar move a janela; os botões só têm ícone, o nome fica na dica -->
    <Grid x:Name="barra" Height="32" Background="{StaticResource Laranja}" MouseLeftButtonDown="Barra_MouseLeftButtonDown">
        <Button x:Name="botaoFecharJanela" Style="{StaticResource BotaoFecharDaBarra}" HorizontalAlignment="Right" Margin="0,0,3,0"
                ToolTip="Fechar o Olho no Chat" AutomationProperties.Name="Fechar" Click="Fechar_Click" />
        <StackPanel Orientation="Horizontal" Margin="3,0,40,0" VerticalAlignment="Center">
            <!-- Olho riscado -->
            <Button x:Name="botaoOcultarBordas" Style="{StaticResource BotaoDaBarra}" AutomationProperties.Name="Ocultar bordas"
                    Click="OcultarBordas_Click">
                <TextBlock Style="{StaticResource IconeDaBarra}" Text="&#xED1A;" />
            </Button>

            <Rectangle Style="{StaticResource SeparadorDaBarra}" />

            <!-- Abrem um painel com o controle deslizante; a rodinha em cima deles muda o valor na hora -->
            <Button x:Name="botaoTamanhoDoTexto" Style="{StaticResource BotaoDaBarraComPainel}" AutomationProperties.Name="Tamanho do texto"
                    PreviewMouseLeftButtonDown="BotaoDePainel_PreviewMouseLeftButtonDown" Click="BotaoDePainel_Click"
                    PreviewMouseWheel="BotaoDePainel_PreviewMouseWheel" MouseLeave="BotaoDePainel_MouseLeave">
                <Button.ToolTip>
                    <ToolTip x:Name="dicaTamanhoDoTexto" />
                </Button.ToolTip>
                <TextBlock Style="{StaticResource IconeDaBarra}" Text="&#xE8D2;" />
            </Button>
            <Button x:Name="botaoFundo" Style="{StaticResource BotaoDaBarraComPainel}" AutomationProperties.Name="Fundo"
                    PreviewMouseLeftButtonDown="BotaoDePainel_PreviewMouseLeftButtonDown" Click="BotaoDePainel_Click"
                    PreviewMouseWheel="BotaoDePainel_PreviewMouseWheel" MouseLeave="BotaoDePainel_MouseLeave">
                <Button.ToolTip>
                    <ToolTip x:Name="dicaFundo" />
                </Button.ToolTip>
                <ContentControl Template="{StaticResource IconeDoFundo}" />
            </Button>

            <Rectangle Style="{StaticResource SeparadorDaBarra}" />

            <!-- Aceso com o alfinete enquanto está ligado -->
            <ToggleButton x:Name="botaoSempreNoTopo" Style="{StaticResource BotaoDaBarraLigaDesliga}" AutomationProperties.Name="Sempre no topo"
                          Checked="SempreNoTopo_Mudou" Unchecked="SempreNoTopo_Mudou">
                <TextBlock Style="{StaticResource IconeSempreNoTopo}" FontSize="20" />
            </ToggleButton>
            <Rectangle Style="{StaticResource SeparadorDaBarra}" />

            <!-- Chat Multiplataforma (Twitch + YouTube) ou só a Twitch: os logos coloridos das duas plataformas (diferente do
                 balão do Escrever). Só Twitch: o do YouTube fica apagado; ligado: os dois acesos no fundo branco. -->
            <ToggleButton x:Name="botaoMultiplataforma" Style="{StaticResource BotaoDaBarraLigaDesliga}" Width="48"
                          AutomationProperties.Name="Chat Multiplataforma" Checked="Multiplataforma_Mudou" Unchecked="Multiplataforma_Mudou">
                <Canvas Width="38" Height="18">
                    <!-- Twitch -->
                    <Path Fill="White" Data="M3,3 H14 V9 L11,12 H8 L6,14 V12 H3 Z" />
                    <Path Fill="#9146FF" Data="M3,1 L1,4 V15 H5 V18 L8,15 H11 L16,10 V1 Z M14,9 L11,12 H8 L6,14 V12 H3 V3 H14 Z" />
                    <Path Fill="#9146FF" Data="M10,5 H11.5 V8.5 H10 Z M6.8,5 H8.3 V8.5 H6.8 Z" />
                    <!-- YouTube -->
                    <Grid Canvas.Left="21" Canvas.Top="3.5" Width="17" Height="12">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="0.45" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border CornerRadius="3.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                            <Setter Property="Background" Value="#FF0000" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Path Data="M6.8,3.2 V8.8 L11.6,6 Z">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource Laranja}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Canvas>
            </ToggleButton>

            <!-- Abre e fecha a caixa "Escrever no chat…": aceso enquanto ela está aberta -->
            <ToggleButton x:Name="botaoEscrever" Style="{StaticResource BotaoDaBarraLigaDesliga}" AutomationProperties.Name="Escrever"
                          Checked="Escrever_Mudou" Unchecked="Escrever_Mudou">
                <TextBlock Style="{StaticResource IconeDaBarra}" Text="&#xE8BD;" />
            </ToggleButton>
            <Rectangle Style="{StaticResource SeparadorDaBarra}" />

            <!-- Abre as Configurações (botão esquerdo ou direito) -->
            <Button x:Name="botaoConfiguracoes" Style="{StaticResource BotaoDaBarra}" ToolTip="Configurações"
                    AutomationProperties.Name="Configurações" Click="Configuracoes_Click" MouseRightButtonUp="Configuracoes_Click">
                <TextBlock Style="{StaticResource IconeDaBarra}" Text="&#xE713;" />
            </Button>
        </StackPanel>

        <Popup x:Name="painelTamanhoDoTexto" PlacementTarget="{Binding ElementName=botaoTamanhoDoTexto}" Placement="Bottom"
               VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <chat:PainelDeAjuste x:Name="ajusteTamanhoDoTexto" Nome="TamanhoDoTexto" Titulo="Tamanho do texto"
                                 Minimo="0.5" Maximo="2.5" Passo="0.05" PassoDoTeclado="0.1" PassoDaRodinha="0.1"
                                 LegendaMenor="menor" LegendaMaior="maior">
                <chat:PainelDeAjuste.Icone>
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE8D2;" FontSize="15" />
                </chat:PainelDeAjuste.Icone>
            </chat:PainelDeAjuste>
        </Popup>

        <Popup x:Name="painelFundo" PlacementTarget="{Binding ElementName=botaoFundo}" Placement="Bottom"
               VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <!-- Em porcentagem; gravado de 0 a 255 -->
            <chat:PainelDeAjuste x:Name="ajusteFundo" Nome="Fundo" Titulo="Fundo do chat"
                                 Minimo="0" Maximo="100" Passo="5" PassoDoTeclado="5" PassoDaRodinha="5"
                                 LegendaMenor="transparente" LegendaMaior="escuro">
                <chat:PainelDeAjuste.Icone>
                    <ContentControl Template="{StaticResource IconeDoFundo}" />
                </chat:PainelDeAjuste.Icone>
            </chat:PainelDeAjuste>
        </Popup>
    </Grid>
</UserControl>
