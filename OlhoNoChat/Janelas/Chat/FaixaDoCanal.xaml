<UserControl x:Class="OlhoNoChat.Janelas.Chat.FaixaDoCanal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OlhoNoChat.Controles">
    <UserControl.Resources>
        <!-- O logo da Twitch (o balão roxo com os dois olhos) -->
        <ControlTemplate x:Key="LogoDaTwitch" TargetType="ContentControl">
            <Viewbox Width="12" Height="14" VerticalAlignment="Center">
                <Canvas Width="2400" Height="2800">
                    <Path Fill="White" Data="M600,200 H2200 V1300 L1800,1700 H1400 L1050,2050 V1700 H600 Z" />
                    <Path Fill="#9146FF" Data="M500,0 L0,500 V2300 H600 V2800 L1100,2300 H1500 L2400,1400 V0 Z M2200,1300 L1800,1700 H1400 L1050,2050 V1700 H600 V200 H2200 Z" />
                    <Path Fill="#9146FF" Data="M1700,550 H1900 V1150 H1700 Z M1150,550 H1350 V1150 H1150 Z" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>
        <!-- O botão de play do YouTube -->
        <ControlTemplate x:Key="LogoDoYouTube" TargetType="ContentControl">
            <Grid Width="16" Height="11" VerticalAlignment="Center">
                <Border Background="#FF0000" CornerRadius="3" />
                <Path Data="M6.3,2.8 L6.3,8.2 L10.8,5.5 Z" Fill="White" />
            </Grid>
        </ControlTemplate>
        <!-- O "K" verde em blocos da Kick, no quadrado preto -->
        <ControlTemplate x:Key="LogoDaKick" TargetType="ContentControl">
            <Grid Width="14" Height="14" VerticalAlignment="Center">
                <Border Background="#0B0B0B" CornerRadius="3" />
                <Path Fill="#53FC18" Data="M2.5,2.5 H5.5 V5.1 H6.8 V3.8 H8.1 V2.5 H11.5 V5.5 H10.2 V6.7 H8.9 V7.3 H10.2 V8.5 H11.5 V11.5 H8.1 V10.2 H6.8 V8.9 H5.5 V11.5 H2.5 Z" />
            </Grid>
        </ControlTemplate>
        <!-- O ponto da conexão no canto do logo, com um anel da cor da faixa para destacar do logo -->
        <Style x:Key="PontoNoLogo" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Stroke" Value="{StaticResource FundoDaFaixa}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,-4,-3" />
        </Style>
        <!-- O nome: cortado com "…" quando não cabe; dentro de uma moldura (Grid com ClipToBounds) onde desliza com o mouse
             em cima, ver NomeQueDesliza -->
        <Style x:Key="NomeNaFaixa" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <!-- O canal do chat, embaixo da barra laranja. Numa linha própria da janela, como a caixa de escrever: a página do chat
         (WebView2) é desenhada por cima de qualquer coisa que fique no lugar dela. -->
    <Border Background="{StaticResource FundoDaFaixa}" BorderBrush="{StaticResource LinhaDaFaixa}" BorderThickness="0,0,0,1">
        <Grid>
            <!-- Fechada: só o canal; o clique abre a caixa do nome -->
            <!-- Os canais numa linha só: o logo com o ponto da conexão no canto (verde / amarelo / vermelho; o do YouTube fica
                 cinza esperando a live) e o nome. O YouTube e a Kick só no Chat Multiplataforma, com canal. Sem espaço, só os
                 nomes compridos são cortados (PainelDosCanais) e deslizam com o mouse em cima (NomeQueDesliza). -->
            <Button x:Name="botaoTrocarCanal" Style="{StaticResource BotaoPlano}" Height="30" Padding="10,0,10,0"
                    AutomationProperties.Name="Trocar canal" ToolTip="{Binding DicaDaFaixa}"
                    Visibility="{Binding EditorAberto, Converter={StaticResource VisivelSe}, ConverterParameter=Nao}" Click="TrocarCanal_Click"
                    MouseEnter="Faixa_MouseEnter" MouseLeave="Faixa_MouseLeave">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ctl:PainelDosCanais Margin="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <DockPanel Visibility="{Binding TwitchNaFaixa, Converter={StaticResource VisivelSe}}">
                            <Grid DockPanel.Dock="Left" Margin="0,0,9,0" VerticalAlignment="Center">
                                <ContentControl Template="{StaticResource LogoDaTwitch}" Focusable="False" />
                                <Ellipse x:Name="pontoDeConexao" Style="{StaticResource PontoNoLogo}" Visibility="Collapsed" />
                            </Grid>
                            <Grid ClipToBounds="True">
                                <TextBlock x:Name="textoCanal" Text="{Binding CanalSalvo}" Style="{StaticResource NomeNaFaixa}" />
                            </Grid>
                        </DockPanel>
                        <DockPanel x:Name="youTubeNaFaixa" Visibility="{Binding YouTubeNaFaixa, Converter={StaticResource VisivelSe}}">
                            <Grid DockPanel.Dock="Left" Margin="0,1,9,0" VerticalAlignment="Center">
                                <ContentControl Template="{StaticResource LogoDoYouTube}" Focusable="False" />
                                <Ellipse x:Name="pontoDoYouTube" Style="{StaticResource PontoNoLogo}" />
                            </Grid>
                            <Grid ClipToBounds="True">
                                <TextBlock x:Name="textoYouTube" Text="{Binding YouTubeSalvo}" Style="{StaticResource NomeNaFaixa}" />
                            </Grid>
                        </DockPanel>
                        <DockPanel x:Name="kickNaFaixa" Visibility="{Binding KickNaFaixa, Converter={StaticResource VisivelSe}}">
                            <Grid DockPanel.Dock="Left" Margin="0,0,9,0" VerticalAlignment="Center">
                                <ContentControl Template="{StaticResource LogoDaKick}" Focusable="False" />
                                <Ellipse x:Name="pontoDaKick" Style="{StaticResource PontoNoLogo}" />
                            </Grid>
                            <Grid ClipToBounds="True">
                                <TextBlock x:Name="textoKick" Text="{Binding KickSalvo}" Style="{StaticResource NomeNaFaixa}" />
                            </Grid>
                        </DockPanel>
                    </ctl:PainelDosCanais>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource IconeDaFaixa}" Text="&#xE8AB;" FontSize="12" Foreground="{StaticResource LaranjaClaro}" />
                        <!-- Com mais de um canal, só o ícone (o texto fica na dica) -->
                        <TextBlock Text="Trocar canal" Margin="5,0,0,1" FontSize="12" Foreground="{StaticResource LaranjaClaro}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding VariosCanaisNaFaixa, Converter={StaticResource VisivelSe}, ConverterParameter=Nao}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Aberta: a caixa do nome, com o logo da plataforma ao lado. Sempre aberta enquanto não há canal. -->
            <Grid x:Name="editorDoCanal" Margin="6,6,6,5" Visibility="{Binding EditorAberto, Converter={StaticResource VisivelSe}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- A mesma largura para os logos: as caixas ficam alinhadas -->
                <ContentControl Width="16" Margin="2,0,8,0" Template="{StaticResource LogoDaTwitch}" Focusable="False" />
                <TextBox x:Name="caixaCanal" Grid.Column="1" MaxLength="300" MinHeight="32" FontSize="14"
                         ctl:CaixaDeTexto.TextoDeExemplo="{Binding ExemploDaTwitch}" AutomationProperties.Name="Canal da Twitch"
                         Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="CaixaCanal_PreviewKeyDown" />
                <Button x:Name="botaoEntrar" Grid.Column="2" Margin="6,0,0,0" Height="32" MinWidth="0" Padding="12,0"
                        Style="{StaticResource BotaoPrincipal}" Content="Conectar" IsEnabled="{Binding PodeConfirmar}"
                        Click="Entrar_Click" />
                <Button x:Name="botaoCancelarCanal" Grid.Column="3" Margin="4,0,0,0" Width="32" Height="32" Padding="0"
                        Style="{StaticResource BotaoPlano}" HorizontalContentAlignment="Center"
                        ToolTip="Fechar sem trocar (Esc)" AutomationProperties.Name="Cancelar"
                        Visibility="{Binding TemCanal, Converter={StaticResource VisivelSe}}" Click="Cancelar_Click">
                    <!-- Seta para cima: a faixa fecha de novo -->
                    <TextBlock Style="{StaticResource IconeDaFaixa}" Text="&#xE70E;" FontSize="12" Foreground="{StaticResource TextoDaDica}" />
                </Button>
                <!-- Chat Multiplataforma: o canal do YouTube (pode ficar vazio) -->
                <ContentControl Grid.Row="1" Width="16" Margin="2,6,8,0" Template="{StaticResource LogoDoYouTube}" Focusable="False"
                                Visibility="{Binding Multiplataforma, Converter={StaticResource VisivelSe}}" />
                <TextBox x:Name="caixaYouTube" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" MaxLength="300" MinHeight="32" FontSize="14"
                         ctl:CaixaDeTexto.TextoDeExemplo="Canal do YouTube (@canal ou link da live)"
                         AutomationProperties.Name="Canal do YouTube"
                         Visibility="{Binding Multiplataforma, Converter={StaticResource VisivelSe}}"
                         Text="{Binding TextoDoYouTube, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="CaixaCanal_PreviewKeyDown" />
                <!-- e o da Kick (também pode ficar vazio) -->
                <ContentControl Grid.Row="2" Width="16" Margin="2,6,8,0" Template="{StaticResource LogoDaKick}" Focusable="False"
                                Visibility="{Binding Multiplataforma, Converter={StaticResource VisivelSe}}" />
                <TextBox x:Name="caixaKick" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" MaxLength="300" MinHeight="32" FontSize="14"
                         ctl:CaixaDeTexto.TextoDeExemplo="Canal da Kick (nome ou link)"
                         AutomationProperties.Name="Canal da Kick"
                         Visibility="{Binding Multiplataforma, Converter={StaticResource VisivelSe}}"
                         Text="{Binding TextoDaKick, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="CaixaCanal_PreviewKeyDown" />
                <TextBlock x:Name="dicaCanal" Grid.Row="3" Grid.ColumnSpan="2" Margin="2,5,8,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Dica}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextoDaDica}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DicaEhErro}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErroDaFaixa}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="botaoSairDoCanal" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,3,0,0"
                        Style="{StaticResource BotaoLink}" Content="Sair do canal" ToolTip="Para de mostrar o chat desse canal"
                        Visibility="{Binding TemCanal, Converter={StaticResource VisivelSe}}" Click="SairDoCanal_Click" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
