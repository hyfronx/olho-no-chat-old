<UserControl x:Class="OlhoNoChat.Janelas.Chat.FaixaDoCanal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OlhoNoChat.Controles">
    <UserControl.Resources>
        <!-- O logo da Twitch (o balão roxo com os dois olhos) -->
        <ControlTemplate x:Key="LogoDaTwitch" TargetType="ContentControl">
            <Viewbox Width="12" Height="14" VerticalAlignment="Center">
                <Canvas Width="2400" Height="2800">
                    <Path Fill="White" Data="M600,200 H2200 V1300 L1800,1700 H1400 L1050,2050 V1700 H600 Z" />
                    <Path Fill="#9146FF" Data="M500,0 L0,500 V2300 H600 V2800 L1100,2300 H1500 L2400,1400 V0 Z M2200,1300 L1800,1700 H1400 L1050,2050 V1700 H600 V200 H2200 Z" />
                    <Path Fill="#9146FF" Data="M1700,550 H1900 V1150 H1700 Z M1150,550 H1350 V1150 H1150 Z" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>
        <!-- O botão de play do YouTube -->
        <ControlTemplate x:Key="LogoDoYouTube" TargetType="ContentControl">
            <Grid Width="16" Height="11" VerticalAlignment="Center">
                <Border Background="#FF0000" CornerRadius="3" />
                <Path Data="M6.3,2.8 L6.3,8.2 L10.8,5.5 Z" Fill="White" />
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>

    <!-- O canal do chat, embaixo da barra laranja. Numa linha própria da janela, como a caixa de escrever: a página do chat
         (WebView2) é desenhada por cima de qualquer coisa que fique no lugar dela. -->
    <Border Background="{StaticResource FundoDaFaixa}" BorderBrush="{StaticResource LinhaDaFaixa}" BorderThickness="0,0,0,1">
        <Grid>
            <!-- Fechada: só o canal; o clique abre a caixa do nome -->
            <Button x:Name="botaoTrocarCanal" Style="{StaticResource BotaoPlano}" Height="30" Padding="10,0,10,0"
                    AutomationProperties.Name="Trocar canal" ToolTip="{Binding DicaDaFaixa}"
                    Visibility="{Binding EditorAberto, Converter={StaticResource VisivelSe}, ConverterParameter=Nao}" Click="TrocarCanal_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Template="{StaticResource LogoDaTwitch}" Focusable="False" />
                    <!-- O nome e, logo depois dele, o ponto da conexão (verde / amarelo piscando / vermelho). No Chat
                         Multiplataforma, depois vem o canal do YouTube com o ponto dele (cinza = esperando a live). -->
                    <Grid Grid.Column="1" Margin="8,0,8,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <Ellipse x:Name="pontoDeConexao" DockPanel.Dock="Right" Width="8" Height="8" Margin="7,1,0,0"
                                     VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="textoCanal" Text="{Binding CanalSalvo}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Texto}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <DockPanel x:Name="youTubeNaFaixa" Grid.Column="1" Margin="12,0,0,0"
                                   Visibility="{Binding YouTubeNaFaixa, Converter={StaticResource VisivelSe}}">
                            <ContentControl DockPanel.Dock="Left" Template="{StaticResource LogoDoYouTube}" Margin="0,1,6,0" Focusable="False" />
                            <Ellipse x:Name="pontoDoYouTube" DockPanel.Dock="Right" Width="8" Height="8" Margin="7,1,0,0"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="textoYouTube" Text="{Binding YouTubeSalvo}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Texto}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource IconeDaFaixa}" Text="&#xE8AB;" FontSize="12" Foreground="{StaticResource LaranjaClaro}" />
                        <!-- Com os dois canais, só o ícone (o texto fica na dica) -->
                        <TextBlock Text="Trocar canal" Margin="5,0,0,1" FontSize="12" Foreground="{StaticResource LaranjaClaro}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding YouTubeNaFaixa, Converter={StaticResource VisivelSe}, ConverterParameter=Nao}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Aberta: a caixa do nome, com o logo da plataforma ao lado. Sempre aberta enquanto não há canal. -->
            <Grid x:Name="editorDoCanal" Margin="6,6,6,5" Visibility="{Binding EditorAberto, Converter={StaticResource VisivelSe}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- A mesma largura para os dois logos: as caixas ficam alinhadas -->
                <ContentControl Width="16" Margin="2,0,8,0" Template="{StaticResource LogoDaTwitch}" Focusable="False" />
                <TextBox x:Name="caixaCanal" Grid.Column="1" MaxLength="300" MinHeight="32" FontSize="14"
                         ctl:CaixaDeTexto.TextoDeExemplo="Nome do canal da Twitch" AutomationProperties.Name="Canal da Twitch"
                         Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="CaixaCanal_PreviewKeyDown" />
                <Button x:Name="botaoEntrar" Grid.Column="2" Margin="6,0,0,0" Height="32" MinWidth="0" Padding="12,0"
                        Style="{StaticResource BotaoPrincipal}" Content="Conectar" IsEnabled="{Binding PodeConfirmar}"
                        Click="Entrar_Click" />
                <Button x:Name="botaoCancelarCanal" Grid.Column="3" Margin="4,0,0,0" Width="32" Height="32" Padding="0"
                        Style="{StaticResource BotaoPlano}" HorizontalContentAlignment="Center"
                        ToolTip="Fechar sem trocar (Esc)" AutomationProperties.Name="Cancelar"
                        Visibility="{Binding TemCanal, Converter={StaticResource VisivelSe}}" Click="Cancelar_Click">
                    <!-- Seta para cima: a faixa fecha de novo -->
                    <TextBlock Style="{StaticResource IconeDaFaixa}" Text="&#xE70E;" FontSize="12" Foreground="{StaticResource TextoDaDica}" />
                </Button>
                <!-- Chat Multiplataforma: o canal do YouTube (pode ficar vazio) -->
                <ContentControl Grid.Row="1" Width="16" Margin="2,6,8,0" Template="{StaticResource LogoDoYouTube}" Focusable="False"
                                Visibility="{Binding ComYouTube, Converter={StaticResource VisivelSe}}" />
                <TextBox x:Name="caixaYouTube" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" MaxLength="300" MinHeight="32" FontSize="14"
                         ctl:CaixaDeTexto.TextoDeExemplo="Canal do YouTube (@canal ou link da live)"
                         AutomationProperties.Name="Canal do YouTube"
                         Visibility="{Binding ComYouTube, Converter={StaticResource VisivelSe}}"
                         Text="{Binding TextoDoYouTube, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="CaixaCanal_PreviewKeyDown" />
                <TextBlock x:Name="dicaCanal" Grid.Row="2" Grid.ColumnSpan="2" Margin="2,5,8,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Dica}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextoDaDica}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DicaEhErro}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErroDaFaixa}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="botaoSairDoCanal" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,3,0,0"
                        Style="{StaticResource BotaoLink}" Content="Sair do canal" ToolTip="Para de mostrar o chat desse canal"
                        Visibility="{Binding TemCanal, Converter={StaticResource VisivelSe}}" Click="SairDoCanal_Click" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
