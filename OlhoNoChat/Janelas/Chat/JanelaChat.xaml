<Window x:Class="OlhoNoChat.Janelas.Chat.JanelaChat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chat="clr-namespace:OlhoNoChat.Janelas.Chat"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent" ResizeMode="CanResize" Topmost="True"
        Icon="/icons/olho_no_chat.ico" Title="" Width="360" Height="530" MinWidth="334">
    <!-- O chat por cima do jogo. Tudo é recortado com os cantos arredondados; a linha da moldura só aparece (laranja) no
         modo rolagem com as bordas ocultas. De cima para baixo: barra laranja, faixa do canal, chat, caixa de escrever. -->
    <Border x:Name="moldura" CornerRadius="10" BorderThickness="0" BorderBrush="Transparent">
        <Grid x:Name="grade">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <chat:BarraDeCima x:Name="barraDeCima" />

            <!-- O fundo escuro atrás do chat; a página do chat (o navegador) entra na linha 2 pelo NavegadorDoChat -->
            <Border x:Name="fundoEscuro" Grid.Row="2" Background="Black" Opacity="0.01" Panel.ZIndex="1" />

            <chat:FaixaDoCanal x:Name="faixaDoCanal" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="2" />

            <chat:CaixaDeEscrever x:Name="caixaDeEscrever" Grid.Row="3" Visibility="Collapsed" Panel.ZIndex="2" />

            <!-- Os pontinhos do canto de redimensionar (CantoDeRedimensionar) -->
            <Path x:Name="desenhoDoCanto" Grid.Row="1" Grid.RowSpan="3" Width="12" Height="12" Margin="0,0,2,2"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Panel.ZIndex="2" IsHitTestVisible="False"
                  Fill="#8CFFFFFF" Visibility="Collapsed">
                <Path.Data>
                    <GeometryGroup>
                        <EllipseGeometry Center="9,3" RadiusX="1.1" RadiusY="1.1" />
                        <EllipseGeometry Center="9,9" RadiusX="1.1" RadiusY="1.1" />
                        <EllipseGeometry Center="3,9" RadiusX="1.1" RadiusY="1.1" />
                        <EllipseGeometry Center="6,6" RadiusX="1.1" RadiusY="1.1" />
                    </GeometryGroup>
                </Path.Data>
            </Path>

            <chat:CartaoFaltaWebView2 x:Name="cartaoFaltaWebView2" Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="3" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
