<UserControl x:Class="OlhoNoChat.Janelas.Configuracoes.PaginaSobre"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = LogicaSobre. Os estilos com nome vêm da janela (DynamicResource). -->
    <UserControl.Resources>
        <!-- Balões de conversa quase transparentes desenhados na faixa laranja -->
        <Style x:Key="BalaoDaFaixa" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE8BD;" />
            <Setter Property="FontFamily" Value="{DynamicResource FonteDosIcones}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource PaginaComRolagem}">
        <StackPanel Style="{DynamicResource PainelDaPagina}">

            <!-- Cartão do app: faixa laranja, ícone grande, nome, versão e a frase -->
            <Border Background="{DynamicResource FundoDoCartao}" BorderBrush="{DynamicResource BordaDoCartao}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border CornerRadius="9,9,0,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E85D30" Offset="0" />
                                <GradientStop Color="#F0506E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Canvas ClipToBounds="True">
                            <TextBlock Style="{StaticResource BalaoDaFaixa}" FontSize="64" Opacity="0.12" Canvas.Left="22" Canvas.Top="14" />
                            <TextBlock Style="{StaticResource BalaoDaFaixa}" FontSize="30" Opacity="0.16" Canvas.Left="104" Canvas.Top="58" />
                            <TextBlock Style="{StaticResource BalaoDaFaixa}" FontSize="40" Opacity="0.10" Canvas.Left="150" Canvas.Top="4" />
                            <TextBlock Style="{StaticResource BalaoDaFaixa}" FontSize="34" Opacity="0.14" Canvas.Right="118" Canvas.Top="10" />
                            <TextBlock Style="{StaticResource BalaoDaFaixa}" FontSize="72" Opacity="0.10" Canvas.Right="20" Canvas.Top="30" />
                        </Canvas>
                    </Border>

                    <!-- O ícone numa placa escura, metade sobre a faixa -->
                    <Border Grid.RowSpan="2" Width="116" Height="116" CornerRadius="28" Margin="0,46,0,0"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Background="#1C1C1C" BorderBrush="{DynamicResource FundoDoCartao}" BorderThickness="5">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="3" BlurRadius="14" Opacity="0.45" Color="Black" />
                        </Border.Effect>
                        <Image Source="/assets/images/olho_no_chat_256.png" Width="78" Height="78" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="24,70,24,28" HorizontalAlignment="Center">
                        <TextBlock Text="Olho no Chat" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                        <Border HorizontalAlignment="Center" Margin="0,10,0,0" Padding="12,4" CornerRadius="12"
                                Background="#33E85D30" BorderBrush="#99E85D30" BorderThickness="1">
                            <TextBlock x:Name="textoVersao" Foreground="{DynamicResource LaranjaClaro}" FontWeight="SemiBold">
                                <Run Text="Versão" /> <Run Text="{Binding Versao, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <TextBlock Text="Fique de olho no chat da sua live sem sair do jogo." FontSize="15" Foreground="#D6D6D6" Margin="0,16,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Plataformas" Style="{DynamicResource TituloDaSecao}" />
            <Border x:Name="cartaoPlataformas" Style="{DynamicResource Cartao}" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE774;" Style="{DynamicResource IconeDoCartao}" VerticalAlignment="Top" Margin="2,2,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Feito para a Twitch" Style="{DynamicResource Rotulo}" FontWeight="SemiBold" />
                        <TextBlock Style="{DynamicResource Dica}" Margin="0,4,0,0"
                                   Text="O Olho no Chat é focado na Twitch, por isso ela tem mais destaque e todos os recursos: escrever no chat, emotes da sua conta e resgates de pontos. O Chat Multiplataforma, que junta o chat do YouTube e o da Kick, está em Beta: é só para ler e ainda está em testes, então pode ter falhas e mudar." />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Segurança da sua conta" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource CartaoDeAviso}" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEA18;" Style="{DynamicResource IconeDoCartao}" VerticalAlignment="Top" Margin="2,2,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="A conexão com a Twitch é feita no seu navegador" Style="{DynamicResource Rotulo}" FontWeight="SemiBold" />
                        <TextBlock Style="{DynamicResource TextoDoAviso}" Margin="0,4,0,0">
                            <Run Text="O Olho no Chat nunca vê a sua senha. Na sua conta da Twitch, ele aparece como &quot;Olho no Chat&quot; em Configurações &gt; Conexões, e você pode desconectar a qualquer momento: lá ou aqui, na aba Twitch." />
                            <LineBreak />
                            <Hyperlink Command="{Binding AbrirConexoesCommand}"><Run Text="Abrir as conexões da sua conta da Twitch" /></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Links" Style="{DynamicResource TituloDaSecao}" />
            <Button x:Name="cartaoProjeto" Style="{DynamicResource CartaoClicavel}" AutomationProperties.Name="Página do projeto e código-fonte"
                    Command="{Binding AbrirProjetoCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE71B;" Style="{DynamicResource IconeDoCartao}" />
                    <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                        <TextBlock Text="Página do projeto e código-fonte" Style="{DynamicResource Rotulo}" />
                        <TextBlock Text="Abre no navegador." Style="{DynamicResource Dica}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="&#xE8A7;" Style="{DynamicResource Icone}" FontSize="14" Margin="0,0,4,0" />
                </Grid>
            </Button>

            <TextBlock Text="Créditos" Style="{DynamicResource TituloDaSecao}" />
            <Border x:Name="cartaoCreditos" Style="{DynamicResource Cartao}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE767;" Style="{DynamicResource IconeDoCartao}" VerticalAlignment="Top" Margin="2,2,16,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Sons de nova mensagem" Style="{DynamicResource Rotulo}" />
                        <TextBlock x:Name="textoCreditoDosSons" Style="{DynamicResource Dica}">
                            <Run Text="Do" />
                            <Hyperlink Command="{Binding AbrirSiteDosSonsCommand}"><Run Text="notificationsounds.com" /></Hyperlink><Run Text=", com a licença" />
                            <Hyperlink Command="{Binding AbrirLicencaDosSonsCommand}"><Run Text="CC BY 4.0" /></Hyperlink><Run Text=". O link de cada som está no arquivo CREDITOS.txt, na pasta do app." />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
