<UserControl x:Class="OlhoNoChat.Janelas.Configuracoes.PaginaTwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OlhoNoChat.Controles"
             Loaded="Pagina_Loaded" Unloaded="Pagina_Unloaded">
    <!-- DataContext = LogicaTwitch. Os estilos com nome vêm da janela (DynamicResource). -->
    <UserControl.Resources>
        <ctl:VisivelSe x:Key="VisivelSe" />
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource PaginaComRolagem}">
        <StackPanel Style="{DynamicResource PainelDaPagina}">
            <TextBlock Text="Twitch" Style="{DynamicResource TituloDaPagina}" />
            <TextBlock Text="Sua conta da Twitch no Olho no Chat." Style="{DynamicResource SubtituloDaPagina}" />

            <!-- Conta: conectar e desconectar acontecem na hora -->
            <TextBlock Text="Conta" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- A foto do perfil, ou uma pessoa cinza sem conta -->
                    <Grid Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Ellipse Fill="#3A3A3A" />
                        <TextBlock x:Name="iconeSemConta" Text="&#xE77B;" Style="{DynamicResource Icone}" FontSize="20"
                                   Foreground="{DynamicResource TextoDaDica}" HorizontalAlignment="Center" />
                        <Ellipse x:Name="fotoDaConta" Visibility="{Binding Foto, Converter={StaticResource VisivelSe}}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Foto, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                        <TextBlock x:Name="textoConta" Text="{Binding TituloDaConta}" Style="{DynamicResource Rotulo}" />
                        <TextBlock x:Name="dicaConta" Text="{Binding DicaDaConta}" Style="{DynamicResource Dica}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="botaoConectar" Content="{Binding TextoConectar}" MinWidth="110" Style="{DynamicResource BotaoPrincipal}"
                                Command="{Binding ConectarCommand}"
                                Visibility="{Binding MostrarConectar, Converter={StaticResource VisivelSe}}" />
                        <Button x:Name="botaoCancelarConexao" Content="Cancelar" MinWidth="100" Command="{Binding CancelarConexaoCommand}"
                                Visibility="{Binding MostrarCancelar, Converter={StaticResource VisivelSe}}" />
                        <Button x:Name="botaoDesconectar" Content="Desconectar" MinWidth="110" Margin="8,0,0,0" Command="{Binding DesconectarCommand}"
                                Visibility="{Binding MostrarDesconectar, Converter={StaticResource VisivelSe}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{DynamicResource CartaoDeAviso}" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" Style="{DynamicResource IconeDoCartao}" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource TextoDoAviso}"
                               Text="Conectar abre a Twitch no seu navegador. Se você já estiver logado nele, é só clicar em &quot;Autorizar&quot;. O Olho no Chat nunca vê a sua senha e você pode tirar o acesso quando quiser, aqui ou nas configurações da sua conta da Twitch (Conexões)." />
                </Grid>
            </Border>

            <!-- Chat Multiplataforma ligado na aba Chat: o que vem abaixo fica desligado (a conta continua conectada) -->
            <Border x:Name="avisoMultiplataforma" Style="{DynamicResource CartaoDeAviso}" Margin="0,10,0,0"
                    Visibility="{Binding MultiplataformaNaTela, Converter={StaticResource VisivelSe}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE774;" Style="{DynamicResource IconeDoCartao}" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource TextoDoAviso}"
                               Text="O Chat Multiplataforma está ligado (Configurações > Chat): escrever no chat e os resgates ficam desligados para não misturar as plataformas. A sua conta continua conectada." />
                </Grid>
            </Border>

            <StackPanel x:Name="recursosDaTwitch" IsEnabled="{Binding SemMultiplataforma}">
                <TextBlock Text="Escrever no chat" Style="{DynamicResource TituloDaSecao}" />
                <Border Style="{DynamicResource Cartao}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8BD;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Caixa de digitar" Style="{DynamicResource Rotulo}" />
                            <TextBlock x:Name="dicaCaixaDeDigitar" Text="{Binding DicaDaCaixa}" Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ComboBox x:Name="listaCaixaDeDigitar" Grid.Column="2" Style="{DynamicResource ListaDaLinha}"
                                  AutomationProperties.Name="Caixa de digitar" SelectedIndex="{Binding CaixaDeDigitar}">
                            <ComboBoxItem Content="Do Olho no Chat" />
                            <ComboBoxItem Content="Da própria Twitch" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{DynamicResource Cartao}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE724;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Fechar a caixa depois de enviar" Style="{DynamicResource Rotulo}" />
                            <TextBlock x:Name="dicaFecharDepoisDeEnviar" Text="{Binding DicaDeFecharDepoisDeEnviar}" Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorFecharDepoisDeEnviar" Grid.Column="2" IsChecked="{Binding FecharCaixaDepoisDeEnviar}"
                                         AutomationProperties.Name="Fechar a caixa depois de enviar" />
                    </Grid>
                </Border>

                <TextBlock Text="Resgates de pontos do canal" Style="{DynamicResource TituloDaSecao}" />
                <Border Style="{DynamicResource Cartao}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE734;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Mostrar os resgates no chat" Style="{DynamicResource Rotulo}" />
                            <TextBlock Style="{DynamicResource Dica}"
                                       Text="Só os resgates do canal da conta conectada, quando o chat aberto é o desse canal. Aparecem apenas no chat Padrão." />
                            <!-- Quando a Twitch recusa (por exemplo, canal sem pontos de canal) -->
                            <TextBlock x:Name="problemaDosResgates" Text="{Binding ProblemaDosResgates}" Style="{DynamicResource Erro}" Margin="0,6,0,0"
                                       Visibility="{Binding ProblemaDosResgates, Converter={StaticResource VisivelSe}}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorResgates" Grid.Column="2" IsChecked="{Binding MostrarResgates}"
                                         AutomationProperties.Name="Mostrar os resgates no chat" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
